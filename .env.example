NODE_ENV=development
PORT=3000

# Turso / SQLite
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# JWT
JWT_SECRET=change-this-in-production

# MCP Server public URL (required for production)
MCP_SERVER_URL=http://localhost:3000

# Optional: GitHub token for github module
GITHUB_TOKEN=

# Optional: Upstash Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Turso / SQLite
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# JWT / OAuth
JWT_SECRET=change-this-in-production
AUTH_TOKEN_TTL_SECONDS=3600

# MCP Server public URL (required for production)
MCP_SERVER_URL=http://localhost:3000

# Runtime settings
WORKSPACE_DIR=./workspace
EXECUTOR_NODE_TIMEOUT_MS=30000
KERNEL_TOOL_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
MAX_JSON_BODY_BYTES=1048576
MCP_SESSION_TTL_MS=1800000
MCP_MAX_SESSIONS=1000
MODULE_SIGNATURE_MODE=off
MODULE_SIGNATURE_PUBLIC_KEYS=

# Optional OpenTelemetry OTLP/HTTP trace export
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=claude-hub
OTEL_EXPORT_INTERVAL_MS=5000

# Optional: GitHub token for github module
GITHUB_TOKEN=

# Browser module fetch settings
BROWSER_FETCH_TIMEOUT_MS=15000
BROWSER_MAX_BYTES=500000

# Optional: Google Calendar REST API token for calendar module
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_API_BASE_URL=https://www.googleapis.com/calendar/v3

# Embeddings: local hashing by default, or point at an OpenAI-compatible embeddings endpoint
EMBEDDING_PROVIDER=hash
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_CACHE_SIZE=1000
LANCEDB_PATH=./data/lancedb
LANCEDB_LOCK_TIMEOUT_MS=5000
LANCEDB_LOCK_STALE_MS=60000

# Optional: Upstash Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
